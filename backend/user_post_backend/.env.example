# 复制为 .env 并填写你在 MySQL Workbench 登录用的 root 密码
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=在这里填写你的密码
MYSQL_DATABASE=anime_web
FLASK_PORT=5001
# 可选：阿里云等机房访问 Bangumi 图片失败时，配置 HTTPS 代理（与 Node 端 SCRAPER_HTTPS_PROXY 类似）
# BANGUMI_HTTPS_PROXY=http://127.0.0.1:7890
# 线上站点来源（逗号分隔），用于 Flask CORS；浏览器走 /post-api 同源代理时通常不必配
# CORS_ORIGIN=http://47.86.228.151,http://localhost:3001
