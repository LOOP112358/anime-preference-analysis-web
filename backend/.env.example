PORT=4100
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SITE_URL=http://localhost:3001
SITE_NAME=ACG Personality Analyzer
CORS_ORIGIN=http://localhost:3001

# Scraper (Bangumi-first + Wikipedia fallback; shared by /api/analyze and /api/recommend)
# SCRAPER_FETCH_TIMEOUT_MS=22000
# SCRAPER_BUNDLE_CONCURRENCY=2
# 维基补充（Bangumi 之外）：阿里云直连常被 403，本地一般可用
# SCRAPER_WIKI_ENABLED=1
# SCRAPER_WIKI_DELAY_MS=900
# 仅当你在本机真的运行了代理程序时才填（没代理请留空）
# SCRAPER_WIKI_PROXY=
# SCRAPER_HTTPS_PROXY=
# SCRAPER_USER_AGENT=AcgPreferenceAnalyzer/1.0 (contact: your@email.com)

# Task 4 public user lists (collaborative / hybrid). Full GET URL returning JSON.
# 另一分支 Flask 示例：GET /anime/list → { success, message, data: [{ user_id, ani_name, ... }] }
# USER_LISTS_API_URL=http://127.0.0.1:5001/anime/list
# USER_LISTS_API_KEY=
# USER_LISTS_API_TIMEOUT_MS=8000

# 本地联调：用仓库内测试数据跑协同推荐（先启动后端，再配此 URL）
# USER_LISTS_API_URL=http://localhost:4100/api/dev/mock-user-lists
# 需同时在 backend/.env 设置 RECOMMEND_DEV_FIXTURES=1
