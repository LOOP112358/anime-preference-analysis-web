NEXT_PUBLIC_API_BASE_URL=http://localhost:4100/api
# 浏览器端已强制走 /api 与 /post-api，以下变量仅影响服务端构建/SSR，请勿在线上 CI 设为 localhost
# 留空即可；本地 dev 可不设，浏览器仍走 next.config 代理
# NEXT_PUBLIC_API_BASE_URL=

# 手绘品牌资源（文件放 frontend/public/brand 与 public/bg，见目录内 README）
# NEXT_PUBLIC_SITE_BG_URL=/bg/page-bg.png
# NEXT_PUBLIC_SITE_BG_OPACITY=0.9

# 页脚：意见反馈 / 打赏（半公开站点建议勿填邮箱和收款码）
# 反馈仅存服务器 backend/data/feedback.jsonl，访客看不到
# NEXT_PUBLIC_FEEDBACK_GITHUB=   # 可选；会公开你的 GitHub 身份，一般可不填

# 打赏：爱发电单档 ¥5「请作者喝茶」，只配链接即可
# NEXT_PUBLIC_DONATE_LINK=https://afdian.net/a/你的昵称
# NEXT_PUBLIC_DONATE_NOTE=如果这个小站对你有帮助，请作者喝杯茶（¥5）就好。

# 以下可能泄露真实姓名，半公开站点不建议配置
# NEXT_PUBLIC_DONATE_WECHAT_QR=/donate/wechat.png
# NEXT_PUBLIC_DONATE_ALIPAY_QR=/donate/alipay.png
# NEXT_PUBLIC_FEEDBACK_EMAIL=
